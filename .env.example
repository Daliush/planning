# Valeurs de développement local. Copier ce fichier vers .env et changer le mot de passe.
PLANNING_PROJECT_NAME=planning-standalone
PLANNING_DB_NAME=planning
PLANNING_DB_USER=planning
PLANNING_DB_PASSWORD=change-me-local-only
# Port hôte ; les conteneurs utilisent toujours planning-db:5432.
PLANNING_DB_PORT=5435
PLANNING_PORT=8081
PLANNING_FRONTEND_PORT=5174
PLANNING_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
